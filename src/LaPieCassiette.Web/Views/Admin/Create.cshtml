@using LaPieCassiette.Application.DTOs;
@using LaPieCassiette.Domain.Models;
@model LaPieCassiette.Application.DTOs.ProductDto
<script>
    document.getElementById("categoryFilter").addEventListener("change", function () {
        const value = this.value;
        const rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {
            const category = row.querySelector(".category").innerText;

            if (value === "all" || category === value) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });
</script>
<h2>Créer une pioche</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div>
        <label>Nom</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mt-2">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mt-2">
        <label>Image</label>
        <input type="file" name="image" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Tags</label>

        <div class="d-flex flex-wrap gap-2">

            @foreach (var tag in (ViewBag.Tags as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
            {
                <label class="tag-item">

                    <input type="checkbox"
                           name="TagIds"
                           value="@tag.Value"
                           class="tag-checkbox" />

                    <span>@tag.Text</span>

                </label>
            }

        </div>
    </div>
    <button class="btn btn-success mt-3">Créer</button>
</form>