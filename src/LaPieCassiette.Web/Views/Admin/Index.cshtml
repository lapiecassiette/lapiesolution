@using LaPieCassiette.Application;
@using LaPieCassiette.Domain.Models;
@model List<LaPieCassiette.Domain.Models.Product>
<input type="text" placeholder="Rechercher..." onkeyup="filterCards(this.value)">
<h2>Gestion des pioches</h2>

<a asp-action="Create" class="btn btn-primary mb-3">➕ Ajouter une pioche</a>

<div class="d-flex flex-wrap gap-3">

    @foreach (var p in Model)
    {
        <div class="card" style="width:250px;">

            @if (!string.IsNullOrEmpty(p.ImagePath))
            {
                <img src="@p.ImagePath" class="card-img-top" style="height:150px; object-fit:cover;" />
            }

            <div class="card-body">

                <h5 class="card-title">@p.Name</h5>

                <p class="card-text">
                    @p.Description
                </p>
                <div class="mb-2">
                    @foreach (var tag in p.ProductTags.Select(pt => pt.Tag))
                    {
                        <span class="badge bg-dark me-1">
                            @tag.Name
                        </span>
                    }
                </div>
                <!-- STATUT -->
                <div class="mb-2">
                    @if (p.IsPublished)
                    {
                        <span class="badge bg-success">Publié</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Brouillon</span>
                    }
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-between">

                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                        ✏️
                    </a>

                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">
                        🗑️
                    </a>

                    <a asp-action="TogglePublish" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">
                        🔄
                    </a>

                </div>

            </div>
        </div>
    }

</div>
