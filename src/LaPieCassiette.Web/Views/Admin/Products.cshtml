@using LaPieCassiette.Application;
@using LaPieCassiette.Domain.Models;
@model List<Product>

<div class="container">

    <div class="page-header">
        <h1>Produits</h1>
        <a href="/Admin/Create" class="button">+ Ajouter</a>
    </div>
    <input type="text" id="searchInput" placeholder="Rechercher un produit..." />
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th>Prix</th>
                    <th>Image</th>
                  
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>

                        <td>
                            <span class="category">@p.Category</span>
                        </td>

                        <td class="price">@p.Price €</td>

                        <td>
                            @if (!string.IsNullOrEmpty(p.ImagePath))
                            {
                                <img src="@p.ImagePath" style="width:80px;" />
                            }
                        </td>

                     

                        <td class="actions">

                            <a href="/Admin/Edit?id=@p.Id">Modifier</a>

                            <form method="post" action="/Admin/Delete" style="display:inline;">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button onclick="return confirm('Supprimer ?')">Supprimer</button>
                            </form>

                            <form method="post" action="/Admin/TogglePublish" style="display:inline;">
                                <input type="hidden" name="id" value="@p.Id" />

                                <label class="switch">
                                    <input type="checkbox"
                                           onchange="this.form.submit()"
                                           @(p.IsPublished ? "checked" : "") />
                                    <span class="slider"></span>
                                </label>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>

                  
        </table>
    </div>
    <script>
        document.getElementById("searchInput").addEventListener("keyup", function () {
            const value = this.value.toLowerCase();
            const rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? "" : "none";
            });
        });
    </script>

</div>