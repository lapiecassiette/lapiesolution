<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaPieCassiette.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaPieCassiette.Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="@RenderSection("BodyClass", required: false)">

    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">

        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🐦 La Pie Cassiette
            </a>

            <!-- BURGER -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- CONTENU -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <!-- GAUCHE -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="MenuDuJour">La Carte</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Commander">Commander</a>
                    </li>

                </ul>

                <!-- DROITE -->
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Purchase" asp-action="Index"> Achats  </a>

                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>
        <!-- CONTENU -->
        <main class="container py-4">
            <div class="content">
                @RenderBody()
            </div>

        </main>

        <!-- FOOTER -->
        <footer class="border-top footer text-muted text-center py-3">
            <div class="container">
                &copy; 2026 - LaPieCassiette.Web -
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
