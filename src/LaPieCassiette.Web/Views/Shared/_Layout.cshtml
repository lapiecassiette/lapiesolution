<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaPieCassiette.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaPieCassiette.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header class="navbar">

        <div class="nav-container">

            <div class="logo">
                <a asp-controller="Home" asp-action="Index">La Pie Cassiette</a>
            </div>

            <nav>
                <a asp-controller="Home" asp-action="Index"
                   class="@(currentAction == "Index" ? "active" : "")">
                    Accueil
                </a>

                <a asp-controller="Home" asp-action="Menu"
                   class="@(currentAction == "Menu" ? "active" : "")">
                    Carte
                </a>

                <a asp-controller="Admin" asp-action="Products"
                   class="@(currentAction == "Products" ? "active" : "")">
                    Admin
                </a>
            </nav>

        </div>

    </header>
    @RenderBody()
 @*    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> *@

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LaPieCassiette.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
