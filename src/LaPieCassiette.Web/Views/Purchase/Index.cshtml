@using LaPieCassiette.Application;
@using LaPieCassiette.Domain.Models
@model List<Purchase>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛒 Mes achats</h2>

        <a asp-action="Create" class="btn btn-dark">
            + Nouvel achat
        </a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Aucun achat enregistré</p>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th>Catégorie</th>
                        <th>Quantité</th>
                        <th>Fournisseur</th>
                        <th>Prix</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><strong>@p.Name</strong></td>

                            <td>
                                <span class="badge cat-@p.Category.ToString().ToLower()">
                                    @p.Category
                                </span>
                            </td>

                            <td>@p.Quantity @p.Unit</td>

                            <td>
                                @(p.Supplier != null ? p.Supplier : "-")
                            </td>

                            <td>@p.Price €</td>

                            <td>@p.Date.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>