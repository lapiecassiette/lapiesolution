@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<div class="container py-3" style="max-width:600px;">

    <h2>Politique de confidentialité</h2>

    <p>
        La Pie Cassiette respecte votre vie privée.
    </p>

    <h5 class="mt-3">Données collectées</h5>
    <p>
        Les informations que vous fournissez (commande, contact)
        sont utilisées uniquement pour le bon fonctionnement du service.
    </p>

    <h5 class="mt-3">Utilisation</h5>
    <p>
        Les données ne sont pas revendues ni utilisées à des fins commerciales externes.
    </p>

    <h5 class="mt-3">Stockage</h5>
    <p>
        Les données sont conservées de manière sécurisée
        et uniquement le temps nécessaire.
    </p>

    <h5 class="mt-3">Contact</h5>
    <p>
        Pour toute question, vous pouvez me contacter directement.
    </p>

    <p class="mt-4">
        <em>Dernière mise à jour : @DateTime.Now.ToString("MMMM yyyy")</em>
    </p>

</div>
