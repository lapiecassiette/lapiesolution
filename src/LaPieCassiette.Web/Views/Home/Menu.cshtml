@using LaPieCassiette.Application;
@using LaPieCassiette.Domain.Models;
@model List<Product>

<div class="container">

    <h1>La Carte</h1>

    @foreach (var group in Model.GroupBy(p => p.Category))
    {
        <h2 class="category-title">@group.Key</h2>

        <div class="grid">
            @foreach (var p in group)
            {
                <div class="card">

                    @if (!string.IsNullOrEmpty(p.ImagePath))
                    {
                        <img src="@p.ImagePath" />
                    }

                    <div class="content">
                        <h3>@p.Name</h3>
                        <p>@p.Description</p>
                        <span class="price">@p.Price €</span>
                    </div>

                </div>
            }
        </div>
    }

</div>