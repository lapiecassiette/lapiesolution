@using LaPieCassiette.Application;
@using LaPieCassiette.Domain.Models;
@model List<LaPieCassiette.Domain.Models.Product>;

<div class="section">

<h2>Notre concept</h2>

<p>
    Des produits frais, une cuisine maison, une approche moderne de la
    street-food revisitée.
</p>
</div>
<div style="text-align:center">
    
    <img src="~/images/Hero.png" />
   
</div>
<h2>Nos pioches</h2>

<div class="d-flex flex-wrap gap-3">

    @foreach (var p in Model)
    {
        <div style="width:220px; border:1px solid #ddd; padding:10px;">

            @if (!string.IsNullOrEmpty(p.ImagePath))
            {
                <img src="@p.ImagePath" style="width:100%;" />
            }

            <h4>@p.Name</h4>
            <p>@p.Description</p>

        </div>
    }

</div>
